# ── 資料庫 ──
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=fleet
# server 連線字串（compose 內服務名為 db）
DATABASE_URL=postgres://fleet:change_me_strong_password@db:5432/fleet

# ── 後端 server ──
PORT=8080
# 儀表板登入帳密（單一管理員，MVP 用）
ADMIN_USER=admin
ADMIN_PASS=change_me_admin_password
# JWT 簽章密鑰，請改成隨機長字串
JWT_SECRET=change_me_to_a_long_random_secret

# ── Caddy 自動 HTTPS（正式部署用，本機測可忽略）──
# 你的網域，例如 fleet.example.com；本機測填 :8080 走 http
SITE_ADDRESS=:8080
